# Copy to .env and fill in. .env is gitignored.

# Alertmanager slack_configs.channel and slack_configs.api_url.
# Substituted into dcgrafana/alertmanager/alertmanager.yml when the container starts.
SLACK_CHANNEL=
SLACK_WEBHOOK_URL=

# Optional. Empty uses the instance IAM role / default AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Prod region. EC2 jobs in prometheus.yml still set their own regions.
AWS_DEFAULT_REGION=ap-south-1

# insure-public-ip role. Prometheus reads role_arn from prometheus.yml, not this var.
AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/Grafana-access
