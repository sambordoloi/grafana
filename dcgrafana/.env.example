# Copy to .env and fill in. .env is gitignored.

# Slack message. Leave blank to skip Slack.
# Substituted into dcgrafana/alertmanager/alertmanager.yml when the container starts.
SLACK_CHANNEL=
SLACK_WEBHOOK_URL=

# Shift times are 24-hour in this timezone.
ALERT_TIMEZONE=Asia/Kolkata

# One PagerDuty service per person. Put only that person on the service escalation
# policy, then paste that service's Events API v2 Integration Key.
# Format: START|END|INTEGRATION_KEY
# Priya is on call 05:00-14:00. Add SHIFT_NAME lines for the other hours.
# A window that passes midnight (22:00|05:00|key) is supported.
SHIFT_PRIYA=05:00|14:00|

# Called only when no SHIFT_* window matches. Leave blank to place no call off shift.
PAGERDUTY_ROUTING_KEY=

# Optional. Empty uses the instance IAM role / default AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Prod region. EC2 jobs in prometheus.yml still set their own regions.
AWS_DEFAULT_REGION=ap-south-1

# insure-public-ip role. Prometheus reads role_arn from prometheus.yml, not this var.
AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/Grafana-access
