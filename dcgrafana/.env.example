# Copy to .env and fill in. .env is gitignored.

# Slack message. Leave blank to skip Slack.
# Substituted into dcgrafana/alertmanager/alertmanager.yml when the container starts.
SLACK_CHANNEL=
SLACK_WEBHOOK_URL=

# PagerDuty Events API v2 integration key (a routing key, not an API token).
# Create a service in PagerDuty, add Events API v2, and paste the Integration Key.
# On the user profile, add a phone notification rule for high-urgency incidents.
# Critical alerts are sent as severity critical. Warning alerts are sent as warning.
PAGERDUTY_ROUTING_KEY=

# Optional. Empty uses the instance IAM role / default AWS credential chain.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Prod region. EC2 jobs in prometheus.yml still set their own regions.
AWS_DEFAULT_REGION=ap-south-1

# insure-public-ip role. Prometheus reads role_arn from prometheus.yml, not this var.
AWS_ROLE_ARN=arn:aws:iam::ACCOUNT_ID:role/Grafana-access
